# RPC endpoint (Hardhat local node or Infura/Alchemy URL)
NEXT_PUBLIC_WORKSPACE_URL="http://127.0.0.1:8545"

# Pinata IPFS credentials — get yours at https://app.pinata.cloud
NEXT_PUBLIC_PINATA_API_KEY="your_pinata_api_key"
PINATA_SECRET_KEY="your_pinata_secret_key"

# Infura Project ID (for deploying to Polygon Mumbai/Mainnet)
INFURA_PROJECT_ID="your_infura_project_id"

# Private key for deployment (DO NOT commit this!)
# DEPLOYER_PRIVATE_KEY="your_wallet_private_key"

